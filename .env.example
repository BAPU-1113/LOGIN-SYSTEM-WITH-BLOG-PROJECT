# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/dish_booking_db

# JWT Authentication
JWT_SECRET=dish_booking_jwt_secret_token_secure_key_2026
JWT_EXPIRES_IN=7d

# Password Reset Token Expiry (in minutes)
RESET_PASSWORD_EXPIRES_MINUTES=15

# Client Base URL (for reset password links)
CLIENT_URL=http://localhost:5000

# Nodemailer Email Configuration
# Note: If left empty or invalid, system automatically generates an Ethereal test account or logs preview links in console!
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Dish Booking System" <no-reply@dishbooking.com>
